---
/**
 * EQUIPMENT GRID COMPONENT
 * Displays a list of available rental items.
 * Fixed: Buttons are now perfectly aligned at the bottom of each card.
 * Follows Golden Rules: clean code, English comments.
 */

const equipment = [
  { name: "Traktorek Kosiarka", price4h: "150", price24h: "250", deposit: "1200" },
  { name: "Glebogryzarka", price4h: "150", price24h: "250", deposit: "500" },
  { name: "Rozdrabniacz Spalinowy", price4h: "150", price24h: "250", deposit: "500" },
  { name: "Wertykulator", price4h: "100", price24h: "150", deposit: "500" },
  { name: "Myjka ciśnieniowa", price4h: "100", price24h: "150", deposit: "300" },
  { name: "Przyczepka platforma", price4h: "60", price24h: "100", deposit: "300" },
  { name: "Okrzesywarka", price4h: "50", price24h: "100", deposit: "200" },
  { name: "Podkaszarka Spalinowa", price4h: "60", price24h: "100", deposit: "300" },
];
---

<section id="oferta" class="py-20 px-6 max-w-6xl mx-auto">
  <h2 class="text-4xl font-black text-luko-yellow uppercase mb-12 text-center italic">
    Nasza Oferta
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {equipment.map((item) => (
      /* FIX: Added 'flex flex-col' to the card container. 
         This allows us to use 'mt-auto' on the button to pin it to the bottom.
      */
      <div class="flex flex-col bg-white/5 border border-white/10 p-6 rounded-2xl hover:border-luko-yellow transition-all duration-300 group">
        
        <div class="flex-grow">
          <h3 class="text-2xl font-bold mb-4 min-h-[4rem]">{item.name}</h3>
          
          <div class="space-y-2 text-sm opacity-80 mb-6">
            <p class="flex justify-between">Cena do 4h: <span class="text-luko-yellow font-bold">{item.price4h} zł</span></p>
            <p class="flex justify-between">Cena za dobę: <span class="text-luko-yellow font-bold">{item.price24h} zł</span></p>
            <hr class="border-white/10 my-2" />
            <p class="flex justify-between italic">Kaucja: <span>{item.deposit} zł</span></p>
          </div>
        </div>

        <a href={`https://wa.me/48537782397?text=Dzień dobry, chciałbym zarezerwować sprzęt: ${item.name}`}
            target="_blank"
            class="w-full mt-auto py-3 rounded-lg bg-luko-yellow text-luko-green font-black uppercase text-xs tracking-widest text-center group-hover:bg-white transition-colors duration-300"
          >
            Zarezerwuj przez WhatsApp
          </a>
      </div>
    ))}
  </div>
  <div class="mt-12 text-center">
    <h3 class="text-xl font-bold text-luko-yellow">
      ...oraz więcej sprzętu pod numerem: <button 
        class="call-trigger text-xl md:text-xl font-black text-luko-yellow hover:scale-105 transition-transform duration-300 cursor-pointer outline-none"
      >
        tel. 537-782-397
      </button>
    </h3>
    <p class="mt-2">świadczymy również usługi serwisowe, transport do klienta, wynajem sprzętu z operatorem...</p>
    <a href="https://www.facebook.com/profile.php?id=61588642397746" target="_blank" class="inline-flex items-center gap-2 mt-4 text-luko-yellow hover:text-white transition-colors duration-300 font-bold drop-shadow-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#1877F2">
        <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
      </svg>
      Facebook: LuKo - Serwis i Wynajem
    </a>
  </div>
</section>