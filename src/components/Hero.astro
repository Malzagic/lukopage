---
/**
 * HERO COMPONENT
 * Features: 
 * 1. Animated Scroll Indicator.
 * 2. Contact Overlay (Confirmation Modal) for phone calls.
 * 3. Mobile-friendly "tel:" integration.
 */

import { Image } from 'astro:assets';
import traktorekImg from '../assets/pictures/traktorek.png';
import glebogryzarkaImg from '../assets/pictures/glebogryzarka.png';
import rozdrabniaczImg from '../assets/pictures/rozdrabniacz.png';
import pilaImg from '../assets/pictures/pilalancuchowa.png';
---
<section class="relative w-full min-h-screen flex flex-col items-center justify-center p-6 text-center overflow-hidden">

   <!-- DECORATIVE EQUIPMENT IMAGES - Floating around the text -->
  <div class="absolute inset-0 pointer-events-none select-none overflow-hidden opacity-70">
    <!-- Top Left: Traktorek -->
    <div class="absolute top-[5%] -left-10 sm:left-0 md:left-[-5%] lg:left-[-8%] xl:left-[8%] animate-float">
      <Image 
        src={traktorekImg} 
        alt="Traktorek kosiarka" 
        width={450}
        loading="eager" 
        fetchpriority="high"
        class="w-35 sm:w-48 md:w-50 lg:w-96 xl:w-112 -rotate-12 drop-shadow-2xl" 
      />
    </div>
    
    <!-- Top Right: Glebogryzarka -->
    <div class="absolute top-[5%] -right-10 sm:right-0 md:right-[-5%] lg:right-[-8%] xl:right-[8%] animate-float" style="animation-delay: 0.7s">
      <Image 
        src={glebogryzarkaImg} 
        alt="Glebogryzarka spalinowa" 
        width={400}
        loading="eager" 
        fetchpriority="high"
        class="w-35 sm:w-40 md:w-50 lg:w-80 xl:w-96 rotate-12 drop-shadow-2xl" 
      />
    </div>

    <!-- Bottom Left: Rozdrabniacz -->
    <div class="absolute bottom-[5%] -left-10 sm:left-[2%] md:left-[-5%] lg:left-[-8%] xl:left-[8%] animate-float" style="animation-delay: 1.4s">
      <Image 
        src={rozdrabniaczImg} 
        alt="Rozdrabniacz do gałęzi" 
        width={400}
        loading="eager" 
        class="w-35 sm:w-36 md:w-50 lg:w-72 xl:w-96 rotate-6 drop-shadow-2xl" 
      />
    </div>

    <!-- Bottom Right: Pila Lancuchowa -->
    <div class="absolute bottom-[5%] -right-10 sm:right-[2%] md:right-[-5%] lg:right-[-8%] xl:right-[8%] animate-float" style="animation-delay: 2.1s">
      <Image 
        src={pilaImg} 
        alt="Piła łańcuchowa" 
        width={350}
        loading="eager" 
        class="w-35 sm:w-44 md:w-50 lg:w-80 -rotate-6 drop-shadow-2xl" 
      />
    </div>
  </div>
  
  <div class="max-w-4xl mx-auto z-10 relative">
    <h1 class="text-8xl md:text-[14rem] font-black text-luko-yellow italic tracking-tighter leading-none drop-shadow-2xl">
      LuKo
    </h1>
    
    <p class="text-xl md:text-3xl font-bold uppercase tracking-[0.2em] mt-2 mb-12">
      wynajem sprzętu ogrodniczego
    </p>

    <div class="flex flex-col gap-6 items-center">
      <button 
        class="call-trigger text-4xl md:text-6xl font-black text-luko-yellow hover:scale-105 transition-transform duration-300 cursor-pointer outline-none"
      >
        tel. 537-782-397
      </button>
      
      <address class="not-italic text-lg md:text-2xl font-medium opacity-90 leading-relaxed">
        Ul. Staromiejska 33 <br />
        74-200 Pyrzyce
      </address>
      <div class="mt-2 text-center">
        <a href="https://www.facebook.com/profile.php?id=61588642397746" target="_blank" class="inline-flex items-center gap-2 mt-4 text-luko-yellow hover:text-white transition-colors duration-300 font-bold drop-shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#1877F2">
                <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
              </svg>
              Facebook: LuKo - Serwis i Wynajem
            </a>
      </div>  
    </div>
  </div>

  <div 
    id="contact-overlay" 
    class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-luko-green/90 backdrop-blur-md p-4 transition-all duration-300"
  >
    <div class="bg-luko-green border-2 border-luko-yellow p-8 rounded-3xl text-center max-w-sm w-full shadow-[0_0_50px_rgba(243,227,0,0.2)]">
      <h3 class="text-2xl font-bold mb-2">Kontakt telefoniczny</h3>
      <p class="mb-8 opacity-80">Czy chcesz połączyć się z numerem <br/><strong>537-782-397</strong>?</p>
      
      <div class="flex flex-col gap-4">
        <a 
          href="tel:537782397" 
          class="bg-luko-yellow text-luko-green py-4 rounded-xl font-black uppercase tracking-widest hover:bg-white transition-colors"
        >
          Zadzwoń teraz
        </a>
        
        <button 
          id="close-overlay"
          class="text-white/50 text-xs uppercase tracking-[0.2em] font-bold py-2 hover:text-white transition-colors"
        >
          Anuluj
        </button>
      </div>
    </div>
  </div>

  <a href="#oferta" class="absolute bottom-10 flex flex-col items-center gap-2 group animate-float opacity-60">
    <span class="text-[10px] uppercase tracking-[0.3em] font-bold text-luko-yellow">Sprawdź ofertę</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-luko-yellow group-hover:translate-y-1 transition-transform">
      <path d="m7 13 5 5 5-5M7 6l5 5 5-5"/>
    </svg>
  </a>
</section>

<script>
  /**
   * CLIENT-SIDE SCRIPT
   * Handles modal visibility toggle.
   */
  const triggers = document.querySelectorAll('.call-trigger');
  const overlay = document.getElementById('contact-overlay');
  const closeBtn = document.getElementById('close-overlay');

  // Show overlay for all triggers
  triggers.forEach(trigger => {
    trigger.addEventListener('click', () => {
      overlay?.classList.remove('hidden');
      document.body.style.overflow = 'hidden'; 
    });
  });

  // Hide overlay
  const hideOverlay = () => {
    overlay?.classList.add('hidden');
    document.body.style.overflow = ''; // Restore scrolling
  };

  closeBtn?.addEventListener('click', hideOverlay);
  
  // Close on backdrop click
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) hideOverlay();
  });
</script>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(10px); }
  }
  .animate-float {
    animation: float 2.5s ease-in-out infinite;
  }
  :global(html) {
    scroll-behavior: smooth;
  }
</style>